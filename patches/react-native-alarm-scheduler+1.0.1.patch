@@ -0,0 +1,72 @@
+package expo.modules.alarm
+
+import kotlin.math.sqrt
+
+/** Gravity estimate + hysteresis; raw accelerometer vibration must not restart the hold. */
+internal class MatrixFlipDetector {
+  private var armed = false
+  private var uprightSince: Long? = null
+  private var downSince: Long? = null
+  private var lastSample: Long? = null
+  private var gx = 0f
+  private var gy = 0f
+  private var gz = 0f
+
+  val state: String
+    get() = when {
+      downSince != null -> "face-down-hold"
+      armed -> "armed"
+      uprightSince != null -> "arming"
+      else -> "waiting"
+    }
+
+  fun reset() {
+    armed = false; uprightSince = null; downSince = null; lastSample = null
+    gx = 0f; gy = 0f; gz = 0f
+  }
+
+  fun update(x: Float, y: Float, z: Float, now: Long): Boolean {
+    if (!x.isFinite() || !y.isFinite() || !z.isFinite()) {
+      uprightSince = null; downSince = null
+      return false
+    }
+    val previous = lastSample
+    if (previous != null && now <= previous) return false
+    val gap = if (previous == null) 0L else now - previous
+    lastSample = now
+    val rawMagnitudeSquared = x * x + y * y + z * z
+    // Reject free fall / hard shocks, while allowing ordinary vibration around gravity.
+    if (rawMagnitudeSquared < 1f || rawMagnitudeSquared >= 324f) {
+      uprightSince = null; downSince = null
+      return false
+    }
+    if (previous == null || gap > 500) {
+      gx = x; gy = y; gz = z
+      uprightSince = null; downSince = null
+    } else {
+      // 150ms time constant adapts to the actual sampling interval.
+      val alpha = 150f / (150f + gap.toFloat())
+      gx = alpha * gx + (1f - alpha) * x
+      gy = alpha * gy + (1f - alpha) * y
+      gz = alpha * gz + (1f - alpha) * z
+    }
+    val magnitude = sqrt(gx * gx + gy * gy + gz * gz)
+    if (magnitude < 6f || magnitude > 15f) {
+      uprightSince = null; downSince = null
+      return false
+    }
+    val faceNormal = gz / magnitude
+    if (!armed) {
+      if (faceNormal > -0.4f) {
+        if (uprightSince == null) uprightSince = now
+        if (now - uprightSince!! >= 300) armed = true
+      } else uprightSince = null
+      return false
+    }
+    // Enter within ~32 degrees of face down; allow ~46 degrees while holding.
+    // This avoids repeatedly clearing the hold at one noisy threshold.
+    if (faceNormal <= -0.85f && downSince == null) downSince = now
+    if (faceNormal > -0.70f) downSince = null
+    return downSince?.let { now - it >= 700 } ?: false
+  }
+}
