{
  "expo": {
    "name": "Matrix",
    "slug": "matrix",
    "icon": "./assets/App_icon.png",
    "android": {
      "package": "com.hotrodtymn.matrix",
      "adaptiveIcon": {
        "foregroundImage": "./assets/App_icon.png",
        "backgroundColor": "#000000"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/48122c28-f27d-45a8-95f7-6d6819693fe9"
    },
    "extra": {
      "eas": {
        "projectId": "48122c28-f27d-45a8-95f7-6d6819693fe9"
      }
    },
    "ios": {},
    "plugins": [
      "react-native-alarm-scheduler",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Matrix to hear push-to-talk reminder commands.",
          "speechRecognitionPermission": "Allow Matrix to transcribe reminder commands."
        }
      ],
      "./modules/hey-matrix/app.plugin.js"
    ],
    "version": "1.3.0"
  }
}
