{
  "expo": {
    "name": "Matrix",
    "slug": "matrix",
    "icon": "./assets/App_icon.png",
    "android": {
      "package": "com.hotrodtymn.matrix",
      "adaptiveIcon": {
        "foregroundImage": "./assets/App_icon.png",
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "matrix-today",
              "host": "dashboard",
              "path": "/today"
            }
          ]
        }
      ]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/48122c28-f27d-45a8-95f7-6d6819693fe9"
    },
    "extra": {
      "eas": {
        "projectId": "48122c28-f27d-45a8-95f7-6d6819693fe9"
      }
    },
    "ios": {},
    "plugins": [
      "react-native-alarm-scheduler",
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MatrixCompatibility",
              "label": "Matrix Today",
              "description": "Today reminders and next alarm. Tap to open Today.",
              "minWidth": "180dp",
              "minHeight": "80dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetCategory": "home_screen"
            }
          ]
        }
      ]
    ],
    "version": "1.5.0"
  }
}
